local function slider(p, text, key, min, max, suffix)
	local row = pill(p, 62)
	label(row, text, UDim2.fromOffset(20, 4), UDim2.new(0.62, -20, 0, 30), nil, 15)
	local val = label(row, "", UDim2.new(0.62, 0, 0, 4), UDim2.new(0.38, -20, 0, 30), Enum.TextXAlignment.Right, 13)
	val.TextColor3, val.Font = C.dim, Enum.Font.GothamBold
	local track = new("TextButton", {Text = "", AutoButtonColor = false, Size = UDim2.new(1, -40, 0, 26), Position = UDim2.fromOffset(20, 32), BackgroundTransparency = 1, BorderSizePixel = 0}, row)
	local bar = new("Frame", {Size = UDim2.new(1, 0, 0, 8), Position = UDim2.fromOffset(0, 9), BackgroundColor3 = C.item, BorderSizePixel = 0}, track)
	circle(bar)
	local fill = new("Frame", {BackgroundColor3 = C.accent, BorderSizePixel = 0}, bar)
	circle(fill)
	local knob = new("Frame", {Size = UDim2.fromOffset(18, 18), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = Color3.fromRGB(195, 232, 255), BorderSizePixel = 0}, bar)
	circle(knob)
	new("UIStroke", {Color = C.accent, Thickness = 2}, knob)
	local function render()
		local a = math.clamp((S[key] - min) / (max - min), 0, 1)
		fill.Size = UDim2.new(a, 0, 1, 0)
		knob.Position = UDim2.new(a, 0, 0.5, 0)
		val.Text = S[key] .. " " .. suffix
	end
	render()
	R[#R + 1] = render
	local function update(x)
		local a = math.clamp((x - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1), 0, 1)
		S[key] = math.floor(min + (max - min) * a + 0.5)
		render()
	end
	local function lock(v)
		local sf = row:FindFirstAncestorOfClass("ScrollingFrame")
		if sf then sf.ScrollingEnabled = v end
	end

	local active, intent, startPos, cur = false, false, nil, nil
	local function release()
		active, intent, cur = false, false, nil
		lock(true)
	end
	connect(track.InputBegan, function(i)
		local t = i.UserInputType
		if t == Enum.UserInputType.MouseButton1 then
			active, intent, cur = true, true, i
			lock(false)
			update(i.Position.X)
		elseif t == Enum.UserInputType.Touch then
			active, intent, startPos, cur = true, false, i.Position, i
		end
	end)
	connect(UserInputService.InputChanged, function(i)
		if not active then return end
		local t = i.UserInputType
		if t == Enum.UserInputType.Touch then
			if i ~= cur then return end
			if intent then
				update(i.Position.X)
			else
				local dx, dy = math.abs(i.Position.X - startPos.X), math.abs(i.Position.Y - startPos.Y)
				if dx > 8 and dx > dy then
					intent = true
					lock(false)
					update(i.Position.X)
				elseif dy > 8 then
					release()
				end
			end
		elseif t == Enum.UserInputType.MouseMovement and intent then
			update(i.Position.X)
		end
	end)
	connect(UserInputService.InputEnded, function(i)
		if not active then return end
		local t = i.UserInputType
		if t == Enum.UserInputType.Touch and i == cur then
			if not intent then update(i.Position.X) end
			release()
		elseif t == Enum.UserInputType.MouseButton1 then
			release()
		end
	end)
end

