local HIDDEN_COLOR = Color3.fromRGB(255, 70, 70)
local NEAREST_COLOR = Color3.fromRGB(255, 120, 255)
local ARMED_COLOR = Color3.fromRGB(255, 150, 40)
local nearestPlr, nearestDist

local CH_EXP = Vector3.new(0.12, 0.12, 0.12)
local function chamsPartsShow(o, ch, col)
	local parts = charExtra(ch)
	local ad = o.cadorn
	local n = #parts
	local pulse = S.ChamsPulse and (0.5 + 0.5 * math.sin(os.clock() * 4)) * 0.35 or 0
	local tr = math.clamp(S.ChamsAlpha / 100 + pulse, 0, 1)
	local top = S.ChamsWall
	for i = 1, n do
		local p = parts[i]
		local a = ad[i]
		if not a then
			a = Instance.new("BoxHandleAdornment")
			a.ZIndex = 1
			a.Parent = chamsRoot
			ad[i] = a
			o.all[#o.all + 1] = a
		end
		if p.Parent then
			if a.Adornee ~= p then a.Adornee = p end
			local sz = p.Size + CH_EXP
			if a.Size ~= sz then a.Size = sz end
			if a.Color3 ~= col then a.Color3 = col end
			if a.Transparency ~= tr then a.Transparency = tr end
			if a.AlwaysOnTop ~= top then a.AlwaysOnTop = top end
			if not a.Visible then a.Visible = true end
		else
			a.Visible = false
		end
	end
	for i = n + 1, o.cn do ad[i].Visible = false end
	o.cn = n
end

local function espPlayer(plr, o, now, vp, camCF, camPos, rainbow)
	local ch, hum, root, head = getChar(plr)
	local isNpc = typeof(plr) == "table"
	if not (S.Esp and ch) or (S.HideTeam and sameTeam(plr)) or (isNpc and not S.Npcs) or (S.XHideFriends and not isNpc and isFriend(plr)) then hideAll(o) return end
	local dist = (root.Position - camPos).Magnitude
	if dist > S.MaxDist then hideAll(o) return end

	if S.VisCheck or S.VisText or S.ChamsDual or S.OnlyVisible then
		if now - o.visT > 0.1 then o.vis, o.visT = visible(ch, head.Position), now end
	end

	if S.OnlyVisible and not o.vis then hideAll(o) return end

	local color
	if S.Rainbow then color = rainbow
	elseif S.DistColor then color = Color3.fromHSV(math.clamp(dist / S.MaxDist, 0, 1) * 0.55, 1, 1)
	elseif S.TeamColor then color = plr.TeamColor.Color
	elseif S.EspCustom then color = Color3.fromRGB(S.CR, S.CG, S.CB)
	else color = P[S.EspColor] end
	if S.FriendColor and isFriend(plr) then color = FRIEND_COLOR end
	if S.VisCheck and o.vis then color = VIS_COLOR end
	if S.XArmed and ch:FindFirstChildOfClass("Tool") then color = ARMED_COLOR end
	if S.XNearest and plr == nearestPlr then color = NEAREST_COLOR end
	if S.TargetHL and plr == tgtPlr then color = TARGET_COLOR end

	local rs = Camera:WorldToViewportPoint(root.Position)
	local onScreen = rs.Z > 0 and rs.X > -80 and rs.X < vp.X + 80 and rs.Y > -80 and rs.Y < vp.Y + 80
	if S.Arrows then
		local dir
		if onScreen then
			dir = Vector2.new(rs.X - vp.X / 2, rs.Y - vp.Y / 2)
		else
			local v = camCF:PointToObjectSpace(root.Position)
			dir = Vector2.new(v.X, -v.Y)
		end
		dir = dir.Magnitude < 1e-3 and Vector2.new(0, -1) or dir.Unit
		local rad = math.max(math.min(vp.X, vp.Y) / 2 - 50, 80)
		o.arrow.Position = UDim2.fromOffset(vp.X / 2 + dir.X * rad, vp.Y / 2 + dir.Y * rad)
		o.arrow.Rotation = math.deg(math.atan2(dir.Y, dir.X)) + 90
		o.arrow.TextColor3, o.arrow.TextSize = color, S.ArrowSize
		o.arrow.Visible = true
	else
		o.arrow.Visible = false
	end
	if not onScreen then
		hideDrawable(o)
		if o.hl.Enabled then o.hl.Enabled = false end
		if o.hl2.Enabled then o.hl2.Enabled = false end
		chamsPartsHide(o)
		return
	end

	local ce = charCache[ch]
	local topW, botW = root.Position + Vector3.new(0, 2.7, 0), root.Position - Vector3.new(0, 3.2, 0)
	local bcf, bsz
	if ce and ce.kind == "custom" then
		local okb, cf2, sz2 = pcall(ch.GetBoundingBox, ch)
		if okb and sz2.Y > 0.5 then
			bcf, bsz = cf2, sz2
			topW, botW = cf2.Position + Vector3.new(0, sz2.Y / 2, 0), cf2.Position - Vector3.new(0, sz2.Y / 2, 0)
		end
	end
	local t = Camera:WorldToViewportPoint(topW)
	local b = Camera:WorldToViewportPoint(botW)
	local h = math.abs(b.Y - t.Y)
	local w, cx = h * (bsz and math.clamp(math.max(bsz.X, bsz.Z) / math.max(bsz.Y, 0.1), 0.3, 1.2) or 0.55), rs.X

	local d = o.d
	d.x, d.y, d.w, d.h = cx - w / 2, t.Y, w, h
	d.color = color
	d.skel = S.Rainbow and rainbow or (S.SkelSame and color or P[S.SkelColor])
	local hpv, hpm = getHp(hum, ch)
	d.hp = math.clamp(hpv / hpm, 0, 1)
	d.tag = plr.Team and plr.Team.Name or nil
	local vel = root.AssemblyLinearVelocity
	local hspd = math.sqrt(vel.X * vel.X + vel.Z * vel.Z)
	d.spd = math.floor(vel.Magnitude + 0.5)
	d.hpn = math.floor(hpv + 0.5)
	d.name = S.NameMode == "User" and plr.Name or plr.DisplayName
	d.dist = S.DistUnit == "m" and math.floor(dist * 0.28) or math.floor(dist)
	d.fade = S.DistFade and math.clamp(1 - (dist / math.max(S.MaxDist, 1)) ^ 2 * 0.7, 0.3, 1) or 1
	if S.Tool then
		local tool = ch:FindFirstChildOfClass("Tool")
		d.tool = tool and tool.Name or nil
	end

	d.alert = false
	if S.LookAlert and dist < 400 then
		local toMe = camPos - head.Position
		if toMe.Magnitude > 1e-3 and head.CFrame.LookVector:Dot(toMe.Unit) > 0.96 then d.alert = true end
	end

	d.pts = o.pts
	if S.Skeleton then
		local list = skelListFor(ch)
		local cache = o.cache
		table.clear(cache)
		local n = 0
		for i = 1, #list do
			local a = jointScreen(ch, list[i][1], cache, projReal)
			local c = a and jointScreen(ch, list[i][2], cache, projReal)
			if c then n += 1; o.pts[n * 2 - 1], o.pts[n * 2] = a, c end
		end
		d.n = n
	else
		d.n = 0
	end

	d.c3 = nil
	if S.Box and S.BoxStyle == "Box3D" then
		local cf = bcf or root.CFrame
		local okc = true
		for i = 1, 8 do
			local co = CORNER_OFFS[i]
			local p2 = projReal(cf * (bsz and Vector3.new(co.X > 0 and bsz.X / 2 or -bsz.X / 2, co.Y > 0 and bsz.Y / 2 or -bsz.Y / 2, co.Z > 0 and bsz.Z / 2 or -bsz.Z / 2) or co))
			if not p2 then okc = false break end
			o.c3[i] = p2
		end
		if okc then d.c3 = o.c3 end
	end

	d.head, d.look = nil, nil
	if S.HeadDot or S.LookLine then
		local hs = Camera:WorldToViewportPoint(head.Position)
		if hs.Z > 0 then
			d.head = Vector2.new(hs.X, hs.Y)
			d.hs = math.clamp(h / 5.9 * head.Size.Y * 1.05, 4, 80)
			if S.LookLine then
				local lp = Camera:WorldToViewportPoint(head.Position + head.CFrame.LookVector * S.LookLen)
				if lp.Z > 0 then d.look = Vector2.new(lp.X, lp.Y) end
			end
		end
	end

	local oy = S.TracerFrom == "Top" and 0 or (S.TracerFrom == "Center" and vp.Y / 2 or vp.Y)
	d.tf = (S.TracerFrom == "Mouse" and UserInputService:GetMouseLocation() or Vector2.new(vp.X / 2, oy))
	if S.TracerTo == "Head" then
		local hs2 = Camera:WorldToViewportPoint(head.Position)
		d.tt = Vector2.new(hs2.X, hs2.Y)
	elseif S.TracerTo == "Body" then
		d.tt = Vector2.new(cx, (t.Y + b.Y) / 2)
	else
		d.tt = Vector2.new(cx, b.Y)
	end

	drawEsp(o, d)

	if S.Chams and S.ChamsMode == "parts" then
		if o.hl.Enabled then o.hl.Enabled = false end
		if o.hl2.Enabled then o.hl2.Enabled = false end
		local cc
		if S.ChamsDual then cc = o.vis and VIS_COLOR or HIDDEN_COLOR
		else cc = S.ChamsSame and color or P[S.ChamsColor] end
		chamsPartsShow(o, ch, cc)
	else
		chamsPartsHide(o)
		if o.hl.Adornee ~= ch then o.hl.Adornee = ch end
		if S.ChamsDual then
			if o.hl2.Adornee ~= ch then o.hl2.Adornee = ch end
			o.hl.FillColor, o.hl.FillTransparency, o.hl.Enabled = HIDDEN_COLOR, S.ChamsAlpha / 100, S.Chams
			o.hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
			o.hl.OutlineTransparency = S.ChamsOutline and 0.2 or 1
			o.hl2.FillColor, o.hl2.FillTransparency, o.hl2.Enabled = VIS_COLOR, S.ChamsAlpha / 100, S.Chams
		else
			if o.hl2.Enabled then o.hl2.Enabled = false end
			o.hl.FillColor, o.hl.FillTransparency, o.hl.Enabled = (S.ChamsSame and color or P[S.ChamsColor]), S.ChamsAlpha / 100, S.Chams
			o.hl.DepthMode = S.ChamsWall and Enum.HighlightDepthMode.AlwaysOnTop or Enum.HighlightDepthMode.Occluded
			o.hl.OutlineTransparency = S.ChamsOutline and 0.2 or 1
		end
	end
end

local function updateEsp(now)
	local vp = Camera.ViewportSize
	local camCF = Camera.CFrame
	local camPos = camCF.Position
	local rainbow = Color3.fromHSV((now * 0.25) % 1, 1, 1)
	nearestPlr, nearestDist = nil, nil
	if S.XNearest or S.XNear or S.XList then
		for plr2 in pairs(esp) do
			if typeof(plr2) == "Instance" and not (S.HideTeam and sameTeam(plr2)) then
				local _, _, r2 = getChar(plr2)
				if r2 then
					local dd = (r2.Position - camPos).Magnitude
					if not nearestDist or dd < nearestDist then nearestPlr, nearestDist = plr2, dd end
				end
			end
		end
	end
	local allow
	if S.MaxShown > 0 and S.Esp then
		local arr = {}
		for plr2 in pairs(esp) do
			local _, _, r2 = getChar(plr2)
			if r2 then arr[#arr + 1] = {plr2, (r2.Position - camPos).Magnitude} end
		end
		table.sort(arr, function(a, b) return a[2] < b[2] end)
		allow = {}
		for i = 1, math.min(S.MaxShown, #arr) do allow[arr[i][1]] = true end
	end
	for plr, o in pairs(esp) do
		local ok, err
		if allow and not allow[plr] then
			ok = pcall(hideAll, o)
		else
			ok, err = pcall(espPlayer, plr, o, now, vp, camCF, camPos, rainbow)
		end
		if not ok then
			pcall(hideAll, o)
			if not warned.espPlayer then
				warned.espPlayer = true
				warn("[pvp universal] esp(" .. tostring(plr.Name) .. "): " .. tostring(err))
			end
		end
	end
end
