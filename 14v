		copy(("PlaceId=%d\nJobId=%s"):format(game.PlaceId, game.JobId), "PlaceId/JobId copiados")
	end

	miscRestore = function()
		for p, o in pairs(pp) do
			if p.Parent then
				pcall(function() p.HoldDuration, p.MaxActivationDistance, p.RequiresLineOfSight = o.h, o.d, o.l end)
			end
		end
		for c, o in pairs(cds) do
			if c.Parent then pcall(function() c.MaxActivationDistance = o.d end) end
		end
		if fovOrig then pcall(function() Camera.FieldOfView = fovOrig end) end
		if stLast then pcall(function() if Camera.CFrame == stLast then Camera.CFrame = stBase end end) end
		if zoomSaved then pcall(function() LocalPlayer.CameraMaxZoomDistance, LocalPlayer.CameraMinZoomDistance = zoomSaved[1], zoomSaved[2] end) end
		if timeSaved then pcall(function() Lighting.ClockTime = timeSaved end) end
		if fxActive then pcall(fxApply, false) end
		if nmActive then pcall(namesApply, false) end
		pcall(miscApi.spectate, false)
	end
end)()
