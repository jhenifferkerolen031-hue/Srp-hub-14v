		if type(hp) ~= "number" then return 100, 100 end
		local mx = ch:GetAttribute("MaxHealth") or ch:GetAttribute("maxHealth") or ch:GetAttribute("MaxHP")
		if type(mx) ~= "number" then
			local v = ch:FindFirstChild("MaxHealth")
			mx = (v and v:IsA("ValueBase") and type(v.Value) == "number") and v.Value or math.max(hp, 100)
		end
		return hp, math.max(mx, 1)
	end

	getChar = function(plr)
		local ch = plr.Character
		if not ch then
			local m = Workspace:FindFirstChild(plr.Name)
			if m and m:IsA("Model") then ch = m end
		end
		if not ch or not ch.Parent then return end
		local now = os.clock()
		local e = charCache[ch]
		if not e or not e.root.Parent or now - e.t > 1.5 then
			local hum = ch:FindFirstChildOfClass("Humanoid") or ch:FindFirstChildWhichIsA("Humanoid", true)
			local root = findRoot(ch, hum)
			if not root then charCache[ch] = nil return end
			local ok, ext = pcall(ch.GetExtentsSize, ch)
			e = {hum = hum, root = root, head = findHead(ch), kind = rigKind(ch), t = now,
				h = (ok and ext.Y > 0.5) and ext.Y or 5.5, proxy = e and e.proxy}
			charCache[ch] = e
		end
		local hp = getHp(e.hum, ch)
		if hp <= 0 then return end
		local head = e.head
		if not head or not head.Parent then
			local px = e.proxy
			if not px then px = Instance.new("Part"); e.proxy = px end
			px.Size = Vector3.new(e.h * 0.18, e.h * 0.18, e.h * 0.18)
			px.CFrame = CFrame.new(e.root.Position + Vector3.new(0, e.h * 0.38, 0)) * e.root.CFrame.Rotation
			head = px
		end
		return ch, e.hum, e.root, head
	end

	charExtra = function(ch)
		local e = charCache[ch]
		if not e then return {}, {} end
		if not e.parts then
			local parts, joints = {}, {}
			for _, d in ipairs(ch:GetDescendants()) do
				if d:IsA("BasePart") then
					if #parts < 60 and d.Transparency < 0.95 and d ~= e.root and not d:FindFirstAncestorWhichIsA("Accessory") then
						parts[#parts + 1] = d
					end
				elseif d:IsA("Motor6D") and #joints < 40 then
					local a, b = d.Part0, d.Part1
					if a and b and a:IsA("BasePart") and b:IsA("BasePart") and a ~= e.root and b ~= e.root
						and not b:FindFirstAncestorWhichIsA("Tool") then
						joints[#joints + 1] = {a, b}
					end
				end
			end
			e.parts, e.joints = parts, joints
		end
		return e.parts, e.joints
	end

	entityList = function(forAim)
		local list = Players:GetPlayers()
