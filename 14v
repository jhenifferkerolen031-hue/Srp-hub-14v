ENV.PvpUniversalCleanup = function()
	pcall(function() RunService:UnbindFromRenderStep("PvpUniversalStep") end)
	pcall(function() RunService:UnbindFromRenderStep("PvpUniversalGhostVis") end)
	if setGhost then pcall(setGhost, false) end
	if moveCleanup then pcall(moveCleanup) end
	if miscRestore then pcall(miscRestore) end
	if markerApi and markerApi.destroy then pcall(markerApi.destroy) end
	for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
	table.clear(conns)
	for plr in pairs(esp) do removeEsp(plr) end
	if chamsRoot then pcall(function() chamsRoot:Destroy() end) end
	pcall(function() gui:Destroy() end)
	pcall(function() espGui:Destroy() end)
end
