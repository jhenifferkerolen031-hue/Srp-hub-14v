	end

	local function speedStep(hum, root, dt, now)
		local md = hum.MoveDirection
		local base = hum.WalkSpeed
		local st = hum:GetState()
		local blocked = hum.Sit or st == Enum.HumanoidStateType.Climbing
			or st == Enum.HumanoidStateType.Swimming or st == Enum.HumanoidStateType.Seated
		local moving = md.Magnitude >= 0.1 and not blocked

		local target = base
		if moving then
			target = S.SpeedVal
			if S.SpeedMode == "gait" then
				target = gaitTarget(base, now, dt, root)
			elseif S.SpeedSmooth then
				target = target * (1 + 0.03 * math.sin(now * 5.1) + 0.02 * math.sin(now * 11.7))
			end
			if S.SpeedBurst and (now % 1.4) > 1.0 then target = base end
		end
		if S.SpeedSmooth or S.SpeedMode == "gait" then
			local rate = target > curSpd and (S.SpeedMode == "gait" and 9 or 3) or 8
			curSpd = curSpd + (target - curSpd) * math.min(1, rate * dt)
		else
			curSpd = target
		end

		if not moving or curSpd <= base + 0.1 then return end
		if S.SpeedMode == "cf" then
			root.CFrame = root.CFrame + md * ((curSpd - base) * dt)
		else
			local v = root.AssemblyLinearVelocity
			root.AssemblyLinearVelocity = Vector3.new(md.X * curSpd, v.Y, md.Z * curSpd)
		end
	end

	local flyPlat, flyY, flyRoot
	local function killPlat()
		if flyPlat then flyPlat:Destroy() flyPlat = nil end
		flyRoot = nil
	end

	local function flyStep(hum, root, dt)
		if not (flyPlat and flyPlat.Parent) then
			flyPlat = Instance.new("Part")
			flyPlat.Name = "pvp universalPlat"
			flyPlat.Size = Vector3.new(14, 1, 14)
			flyPlat.Anchored = true
			flyPlat.CanCollide = true
			flyPlat.CanQuery = false
			flyPlat.CanTouch = false
			flyPlat.CastShadow = false
			flyPlat.Transparency = 1
			flyPlat.Parent = Workspace
			flyRoot = nil
		end
		local feet = feetOf(hum, root)
		if flyRoot ~= root then
			flyRoot = root
			flyY = root.Position.Y - feet
		end

		local up = 0
		if UserInputService:IsKeyDown(Enum.KeyCode.Space) or hum.Jump then up += 1 end
		if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.C) then up -= 1 end
		local rate = up * S.FlySpeed
		local mdF = hum.MoveDirection
		if S.FlyForward and mdF.Magnitude > 0.1 then
			local sp = S.FlyFwdSpeed * (1 + 0.04 * math.sin(os.clock() * 3.7))
			local v0 = root.AssemblyLinearVelocity
			root.AssemblyLinearVelocity = Vector3.new(mdF.X * sp, v0.Y, mdF.Z * sp)
		end
		if up == 0 and S.FlyLook then
			local md = hum.MoveDirection
			local look = Camera.CFrame.LookVector
			local flatM = math.sqrt(look.X * look.X + look.Z * look.Z)
			if md.Magnitude > 0.05 and flatM > 1e-3 then
				local f = md:Dot(Vector3.new(look.X / flatM, 0, look.Z / flatM))
				rate = f * math.clamp(look.Y / flatM, -2, 2) * S.FlySpeed * 0.6
			end
		end
		flyY += rate * dt

		local p = root.Position
		if p.Y - feet < flyY - 12 then flyY = p.Y - feet end

		local vv = root.AssemblyLinearVelocity
		flyPlat.CFrame = CFrame.new(p.X + vv.X * dt, flyY - 0.5, p.Z + vv.Z * dt)
		if rate > 0 then
			local v = root.AssemblyLinearVelocity
			if v.Y < rate then root.AssemblyLinearVelocity = Vector3.new(v.X, rate, v.Z) end
		end
	end

