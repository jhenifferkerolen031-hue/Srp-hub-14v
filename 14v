			if not fbOn then
				for atm, v in pairs(atmSaved) do
					if atm.Parent then atm.Density, atm.Haze = v[1], v[2] end
					atmSaved[atm] = nil
				end
			end
			if not fxOn then
				for d, v in pairs(fxSaved) do
					if d.Parent then d.Enabled = v end
					fxSaved[d] = nil
				end
			end
		end)
		lightBusy = false
	end

	for _, prop in ipairs({"ClockTime", "Brightness", "Ambient", "OutdoorAmbient", "FogStart", "FogEnd", "GlobalShadows"}) do
		connect(Lighting:GetPropertyChangedSignal(prop), function()
