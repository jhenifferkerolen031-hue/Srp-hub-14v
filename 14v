		local look = Vector3.new(lv.X, 0, lv.Z)
		look = look.Magnitude < 1e-3 and Vector3.new(0, 0, -1) or look.Unit
		local right = look:Cross(Vector3.yAxis)

		local origin = camCF.Position
		local mr = G.clone and G.clone:FindFirstChild("HumanoidRootPart")
		if not mr then
			local mch = LocalPlayer.Character
			mr = mch and mch:FindFirstChild("HumanoidRootPart")
		end
		if mr then origin = mr.Position end

		radar.Visible = S.Radar
		if S.Radar then
			local c = Vector2.new(cen, cen)
			local vp = Camera.ViewportSize
			local half = math.atan(math.tan(math.rad(Camera.FieldOfView) / 2) * (vp.X / math.max(vp.Y, 1)))
			for i = 1, 2 do
				local a = half * (i == 1 and -1 or 1)
				setLine(wedge[i], c, c + Vector2.new(math.sin(a), -math.cos(a)) * rad, 1.5, WHITE)
				wedge[i].BackgroundTransparency = 0.55
			end
			local ang = (now * 1.5) % (math.pi * 2)
			for i = 1, 5 do
				local a = ang - (i - 1) * 0.12
				setLine(sweep[i], c, c + Vector2.new(math.sin(a), -math.cos(a)) * rad, i == 1 and 2 or 1.5, SWEEP)
				sweep[i].BackgroundTransparency = 0.45 + (i - 1) * 0.12
			end
			for _, cd in ipairs(CARD) do
				cd.t.Position = UDim2.fromOffset(cen + cd.v:Dot(right) * (rad - 6), cen - cd.v:Dot(look) * (rad - 6))
			end
		end

		local count = 0
		local k = rad / S.RadarRange
		for _, plr in ipairs(entityList(false)) do
			if plr ~= LocalPlayer then
				local ch, _, root = getChar(plr)
				local show = ch and not (S.HideTeam and sameTeam(plr))
				if show then count += 1 end
				if S.Radar then
					local dot = getDot(plr)
					if show then
						local rel = root.Position - origin
						local rx, rz = rel:Dot(right), rel:Dot(look)
						local x, y = rx * k, -rz * k
						local m = math.sqrt(x * x + y * y)
						local edge = m > rad
						if edge then x, y = x / m * rad, y / m * rad end
						local hd = math.sqrt(rx * rx + rz * rz)
						local t = math.clamp(hd / S.RadarRange, 0, 1)
						local sz = edge and 5 or (8 - 3 * t)
						if not edge and hd < 40 then sz += 1.5 * (0.5 + 0.5 * math.sin(now * 7)) end
						local col
						if S.TargetHL and plr == tgtPlr then col = TARGET_COLOR
						elseif S.TeamColor then col = plr.TeamColor.Color
						elseif S.EspCustom then col = Color3.fromRGB(S.CR, S.CG, S.CB)
						else col = P[S.EspColor] end
						dot.Size = UDim2.fromOffset(sz, sz)
						dot.Position = UDim2.fromOffset(cen + x, cen + y)
						dot.BackgroundColor3 = col
						dot.BackgroundTransparency = edge and 0.55 or (0.05 + 0.35 * t)
						dot.Visible = true
						local e = ex[dot]
						local dy = rel.Y
						local g = (not edge) and (dy > 10 and "▲" or (dy < -10 and "▼" or "")) or ""
						if e.h.Text ~= g then e.h.Text = g end
						e.h.TextColor3 = col
						local showName = S.RadarNames and not edge
						e.n.Visible = showName
						if showName then
							local nm = tostring(plr.DisplayName):sub(1, 10)
							if e.n.Text ~= nm then e.n.Text = nm end
							e.n.TextColor3 = col
						end
					else
						dot.Visible = false
					end
				end
			end
		end
		info.Text = count .. "  ·  " .. S.RadarRange .. "m"
		countLbl.Visible = S.ShowCount
		if S.ShowCount then countLbl.Text = "Inimigos: " .. count end
	end
end)()
