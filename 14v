local esp = {}

local function makeEsp(plr)
	if plr == LocalPlayer or esp[plr] then return end
	local o = newDrawable(espGui)
	o.arrow = o.mk("TextLabel", {Text = "▲", BackgroundTransparency = 1, Size = UDim2.fromOffset(24, 24), AnchorPoint = Vector2.new(0.5, 0.5), Font = Enum.Font.GothamBold, TextSize = 22, TextStrokeTransparency = 0.3, Visible = false})
	o.hl = o.mk("Highlight", {FillTransparency = 0.6, OutlineColor = Color3.new(1, 1, 1), OutlineTransparency = 0.2, DepthMode = Enum.HighlightDepthMode.AlwaysOnTop, Enabled = false})
