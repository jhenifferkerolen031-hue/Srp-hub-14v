	o.name = mk("TextLabel", {Text = "", BackgroundTransparency = 1, Size = UDim2.fromOffset(180, 14), AnchorPoint = Vector2.new(0.5, 1), Font = Enum.Font.GothamBold, TextSize = 12, TextStrokeTransparency = 0.4, Visible = false})
	o.info = mk("TextLabel", {Text = "", BackgroundTransparency = 1, Size = UDim2.fromOffset(190, 14), AnchorPoint = Vector2.new(0.5, 0), Font = Enum.Font.GothamMedium, TextSize = 11, TextColor3 = Color3.new(1, 1, 1), TextStrokeTransparency = 0.4, Visible = false})
	o.tool = mk("TextLabel", {Text = "", BackgroundTransparency = 1, Size = UDim2.fromOffset(140, 14), AnchorPoint = Vector2.new(0.5, 0), Font = Enum.Font.GothamMedium, TextSize = 11, TextColor3 = Color3.fromRGB(255, 220, 120), TextStrokeTransparency = 0.4, Visible = false})
	o.xtra = mk("TextLabel", {Text = "", RichText = true, BackgroundTransparency = 1, Size = UDim2.fromOffset(200, 14), AnchorPoint = Vector2.new(0.5, 0), TextYAlignment = Enum.TextYAlignment.Top, Font = Enum.Font.GothamBold, TextSize = 11, TextColor3 = Color3.new(1, 1, 1), TextStrokeTransparency = 0.4, Visible = false})
	o.hpBg = mk("Frame", {BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.3, BorderSizePixel = 0, Visible = false})
	o.hpStroke = new("UIStroke", {Thickness = 1, Color = Color3.new(0, 0, 0), Transparency = 0.2}, o.hpBg)
	o.hp = new("Frame", {AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, 0), Size = UDim2.new(1, 0, 1, 0), BorderSizePixel = 0}, o.hpBg)
	o.hpTxt = mk("TextLabel", {Text = "", BackgroundTransparency = 1, Size = UDim2.fromOffset(38, 12), AnchorPoint = Vector2.new(1, 0.5), TextXAlignment = Enum.TextXAlignment.Right, Font = Enum.Font.GothamBold, TextSize = 10, TextColor3 = Color3.new(1, 1, 1), TextStrokeTransparency = 0.4, Visible = false})
	o.line = mk("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), BorderSizePixel = 0, Visible = false})
	o.look = mk("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), BorderSizePixel = 0, Visible = false})
	o.dot = mk("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1, BorderSizePixel = 0, Visible = false})
	circle(o.dot)
	o.dotStroke = new("UIStroke", {Thickness = 2}, o.dot)
	o.dotIn = mk("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), BorderSizePixel = 0, Visible = false})
