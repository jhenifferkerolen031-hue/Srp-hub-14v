	local function clearModel()
		if model then model:Destroy() end
		model, mroot, mhead, mparts, chamSig = nil, nil, nil, nil, nil
	end
	local function setModel(kind)
		clearModel()
		local m = kind == "avatar" and cloneAvatar() or nil
		usingAvatar = m ~= nil
		m = m or buildClassic(kind ~= "classic")
		m:PivotTo(CFrame.Angles(0, math.rad(25), 0))
		m.Parent = vf
		model, mroot, mhead = m, m:FindFirstChild("HumanoidRootPart"), m:FindFirstChild("Head")
		mparts = {}
		for _, p in ipairs(m:GetDescendants()) do
			if p:IsA("BasePart") and p.Transparency < 1 then mparts[#mparts + 1] = {p = p, c = p.Color, m = p.Material, t = p.Transparency} end
		end
		dirty = true
		if kind ~= "avatar" and kind ~= "classic" and m:FindFirstChild("BaconHair1") then
			loadRealBacon(m, function(p)
				if mparts then mparts[#mparts + 1] = {p = p, c = p.Color, m = p.Material, t = p.Transparency} end
				chamSig = nil
			end)
		end
	end

	local function projV(p)
		local v = vcam.CFrame:PointToObjectSpace(p)
		local depth = -v.Z
		if depth <= 0.1 then return nil end
		local x = (v.X / (depth * tanH * (curSw.X / curSw.Y)) * 0.5 + 0.5) * curSw.X
		local y = (0.5 - v.Y / (depth * tanH) * 0.5) * curSw.Y
		return Vector2.new(x, y)
	end

	local function layout(sw)
		curSw = sw
		local rp = mroot.Position
		local t, b, rs = projV(rp + Vector3.new(0, 2.7, 0)), projV(rp - Vector3.new(0, 3.2, 0)), projV(rp)
		if not (t and b and rs) then return false end
		local h = math.abs(b.Y - t.Y)
		local w = h * 0.55
		d.x, d.y, d.w, d.h = rs.X - w / 2, t.Y, w, h
		shadow.Size, shadow.Position, shadow.Visible = UDim2.fromOffset(h * 0.7, h * 0.09), UDim2.fromOffset(rs.X, b.Y), true
		d.pts = dr.pts

		local list = model:FindFirstChild("UpperTorso") and RIG15 or RIG6
		local cache = {}
		local n = 0
		for i = 1, #list do
			local a = jointScreen(model, list[i][1], cache, projV)
			local c = a and jointScreen(model, list[i][2], cache, projV)
			if c then n += 1; dr.pts[n * 2 - 1], dr.pts[n * 2] = a, c end
		end
		d.n = n
d.c3 = nil
		local cf, okc = mroot.CFrame, true
		for i = 1, 8 do
			local p2 = projV(cf * CORNER_OFFS[i])
			if not p2 then okc = false break end
			dr.c3[i] = p2
		end
		if okc then d.c3 = dr.c3 end

		d.head = projV(mhead.Position)
		d.hs = math.clamp(h / 5.9 * mhead.Size.Y * 1.05, 4, 80)
		d.look = projV(mhead.Position + mhead.CFrame.LookVector * 4)
		d.tt = Vector2.new(rs.X, b.Y)
		d.hp, d.hpn, d.name, d.dist, d.tool = 0.82, 82, "Inimigo", 25, "Espada"
		d.tag, d.spd = "Time A", 16
		d.state, d.vis, d.alert = "Andando", true, true

		mpos.Head = projV(mhead.Position)
		mpos.Neck = projV(mhead.Position - Vector3.new(0, mhead.Size.Y * 0.6, 0))
		mpos.Chest = projV((model:FindFirstChild("UpperTorso") or model:FindFirstChild("Torso") or mroot).Position)
		mpos.Body = projV(mroot.Position)
		mpos.Feet = d.tt
		return true
	end

	local TEAM_DEMO = Color3.fromRGB(255, 150, 60)

	local function update(t)
		local sw = stage.AbsoluteSize
		if S.PreviewModel == "avatar" and not usingAvatar and t - lastTry > 1.5 then
			lastTry = t
			pcall(setModel, "avatar")
		end
		if not model or not mroot or sw.X < 20 or sw.Y < 20 then return end
		if dirty or sw ~= lastSw then
			if layout(sw) then lastSw, dirty = sw, false else return end
		end

		local rb = Color3.fromHSV((math.floor(t * 10) / 10 * 0.25) % 1, 1, 1)
		local color = P[S.EspColor]
		if S.EspCustom then color = Color3.fromRGB(S.CR, S.CG, S.CB) end
		if S.Rainbow then color = rb elseif S.DistColor then color = Color3.fromHSV(0.18, 1, 1) elseif S.TeamColor then color = TEAM_DEMO end
		if S.VisCheck then color = VIS_COLOR end

		local chams = (S.Esp or S.PreviewAlways) and S.Chams
		local sig = chams and (tostring(color) .. S.ChamsAlpha) or "off"
		if sig ~= chamSig then
			chamSig = sig
			for _, e in ipairs(mparts) do
				if chams then
					e.p.Color, e.p.Material, e.p.Transparency = color, Enum.Material.ForceField, math.clamp(S.ChamsAlpha / 100 * 0.7, 0, 0.85)
				else
					e.p.Color, e.p.Material, e.p.Transparency = e.c, e.m, e.t
				end
			end
		end

		local showPv = S.Esp or S.PreviewAlways
		local wantDark = showPv and (color.R + color.G + color.B) / 3 > 0.82
		if wantDark ~= stageDark then
			stageDark = wantDark
			stageGrad.Color = wantDark and DARK_SEQ or LIGHT_SEQ
		end
		status.Visible = not showPv
		if showPv then
			d.color = color
			d.skel = S.Rainbow and rb or (S.SkelSame and color or P[S.SkelColor])
			local oy = S.TracerFrom == "Top" and 0 or (S.TracerFrom == "Center" and sw.Y / 2 or sw.Y)
			d.tf = Vector2.new(sw.X / 2, oy)
			d.tt = S.TracerTo == "Head" and mpos.Head or (S.TracerTo == "Body" and mpos.Body or mpos.Feet)
			drawEsp(dr, d)
			arrow.Visible = S.Arrows
			if S.Arrows then
				arrow.Position = UDim2.fromOffset(sw.X - 22, 22)
				arrow.TextColor3, arrow.TextSize = color, S.ArrowSize
			end
		else
			hideDrawable(dr)
			arrow.Visible = false
		end

		if S.Aim then
			local list = BONE_LIST[S.Bone] or BONE_LIST.Head
			local first
			for i = 1, 3 do
				local pp = list[i] and mpos[list[i]]
				markers[i].Visible = pp ~= nil
				if pp then
					markers[i].Position = UDim2.fromOffset(pp.X, pp.Y)
					first = first or pp
				end
			end
			mtxt.Visible = first ~= nil
			if first then
				mtxt.Position = UDim2.fromOffset(first.X + 12, first.Y)
				mtxt.Text = BONE_NAME[S.Bone] or ""
			end
		else
			for i = 1, 3 do markers[i].Visible = false end
			mtxt.Visible = false
		end
	end

	setModel(S.PreviewModel)
	connect(LocalPlayer.CharacterAdded, function()
		task.delay(2.5, function()
			if S.PreviewModel == "avatar" then pcall(setModel, "avatar") end
		end)
	end)
	return {update = update, setModel = setModel}
end
