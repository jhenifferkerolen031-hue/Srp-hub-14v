local function loadRealBacon(m, onAdded)
	task.spawn(function()
		local ok, objs = pcall(function() return game:GetObjects("rbxassetid://" .. BACON_ASSET) end)
		if not ok or type(objs) ~= "table" or not objs[1] then return end
		local acc = objs[1]
		local nm = acc.Name:lower()
		local handle = acc:FindFirstChild("Handle")
		local head = m.Parent and m:FindFirstChild("Head")
		if not (acc:IsA("Accessory") and (nm:find("pal") or nm:find("bacon")) and handle and handle:IsA("BasePart") and head) then
			acc:Destroy()
			return
		end
		for _, d in ipairs(acc:GetDescendants()) do
			if d:IsA("BaseScript") or d:IsA("Weld") or d:IsA("WeldConstraint") then d:Destroy() end
		end
		local att = handle:FindFirstChild("HairAttachment") or handle:FindFirstChildWhichIsA("Attachment")
		handle.Anchored, handle.CanCollide = true, false
		handle.CFrame = head.CFrame * CFrame.new(0, 0.6, 0) * (att and att.CFrame or CFrame.new()):Inverse()
		for _, d in ipairs(m:GetChildren()) do
			if d.Name:sub(1, 9) == "BaconHair" then d:Destroy() end
		end
		handle.Parent = m
		acc:Destroy()
		onAdded(handle)
	end)
end

