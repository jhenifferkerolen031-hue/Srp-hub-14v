local function J(s)
	local n, m = s:match("^(.-)%.(%a+)$")
	if n then return {n = n, m = m} end
	return {n = s}
end
local function rig(list)
	local r = {}
	for i, p in ipairs(list) do r[i] = {J(p[1]), J(p[2])} end
	return r
end
local RIG15 = rig({
	{"Head", "UpperTorso"}, {"UpperTorso", "LowerTorso"},
	{"UpperTorso", "LeftUpperArm"}, {"LeftUpperArm", "LeftLowerArm"}, {"LeftLowerArm", "LeftHand"},
	{"UpperTorso", "RightUpperArm"}, {"RightUpperArm", "RightLowerArm"}, {"RightLowerArm", "RightHand"},
	{"LowerTorso", "LeftUpperLeg"}, {"LeftUpperLeg", "LeftLowerLeg"}, {"LeftLowerLeg", "LeftFoot"},
	{"LowerTorso", "RightUpperLeg"}, {"RightUpperLeg", "RightLowerLeg"}, {"RightLowerLeg", "RightFoot"},
})
local RIG6 = rig({
	{"Head", "Torso.top"}, {"Torso.top", "Torso.bottom"},
	{"Torso.top", "Left Arm.top"}, {"Left Arm.top", "Left Arm.bottom"},
	{"Torso.top", "Right Arm.top"}, {"Right Arm.top", "Right Arm.bottom"},
	{"Torso.bottom", "Left Leg.top"}, {"Left Leg.top", "Left Leg.bottom"},
	{"Torso.bottom", "Right Leg.top"}, {"Right Leg.top", "Right Leg.bottom"},
})

local CORNER_OFFS = {}
for i = 1, 8 do
	local b = i - 1
	CORNER_OFFS[i] = Vector3.new(b % 2 == 1 and 2 or -2, math.floor(b / 2) % 2 == 1 and 2.7 or -3.2, b >= 4 and 1 or -1)
end
local EDGES = {{1, 2}, {3, 4}, {5, 6}, {7, 8}, {1, 3}, {2, 4}, {5, 7}, {6, 8}, {1, 5}, {2, 6}, {3, 7}, {4, 8}}

local function projReal(pos)
	local sp = Camera:WorldToViewportPoint(pos)
	if sp.Z > 0 then return Vector2.new(sp.X, sp.Y) end
end

local function jointScreen(ch, j, cache, proj)
	local key = j.m and (j.n .. "." .. j.m) or j.n
	local c = cache[key]
	if c ~= nil then return c end
	local r = false
	local part = j.part or ch:FindFirstChild(j.n)
	if part and part:IsA("BasePart") then
		local pos
		if j.m == "top" then pos = part.CFrame * Vector3.new(0, part.Size.Y / 2, 0)
		elseif j.m == "bottom" then pos = part.CFrame * Vector3.new(0, -part.Size.Y / 2, 0)
		else pos = part.Position end
		r = proj(pos) or false
	end
	cache[key] = r
	return r
end

local function skelListFor(ch)
	local e = charCache[ch]
	if e and e.kind == "custom" then
		if not e.cust then
			local _, joints = charExtra(ch)
			local ids, n, list = {}, 0, {}
			local function jp(p)
				local id = ids[p]
				if not id then n += 1; id = {n = "#" .. n, part = p}; ids[p] = id end
				return id
			end
			for i = 1, #joints do list[i] = {jp(joints[i][1]), jp(joints[i][2])} end
			e.cust = list
		end
		return e.cust
	end
	return ch:FindFirstChild("UpperTorso") and RIG15 or RIG6
end

local function newDrawable(parent)
	local o = {all = {}, bones = {}, nb = 0, edges = {}, ne = 0, shown = false, cornerOn = false, ts = 0,
		pts = {}, c3 = {}, cache = {}, vis = false, visT = 0, d = {n = 0}, xbuf = {}, jd = {}, nj = 0, bonesO = {}, dotTk = {}}
	local function mk(class, props)
		local i = new(class, props, parent)
		o.all[#o.all + 1] = i
