	local function lightApply()
		if lightBusy then return end
		lightBusy = true
		pcall(function()
			local fbOn, tOn, fxOn = S.Fullbright, S.TimeOn, S.NoFx
			if fbOn then
				lset("Brightness", 2) lset("FogStart", 1e6) lset("FogEnd", 1e6) lset("GlobalShadows", false)
				lset("Ambient", GREY) lset("OutdoorAmbient", GREY)
				for _, atm in ipairs(Lighting:GetChildren()) do
					if atm:IsA("Atmosphere") then
						if not atmSaved[atm] then atmSaved[atm] = {atm.Density, atm.Haze} end
						if atm.Density ~= 0 then atm.Density = 0 end
						if atm.Haze ~= 0 then atm.Haze = 0 end
					end
				end
			end
			if tOn then lset("ClockTime", S.TimeVal) end
			if fxOn then
				for _, par in ipairs({Lighting, Workspace.CurrentCamera}) do
					if par then
						for _, d in ipairs(par:GetChildren()) do
							if FX_CLASSES[d.ClassName] then
								if fxSaved[d] == nil then fxSaved[d] = d.Enabled end
								if d.Enabled then d.Enabled = false end
							end
						end
					end
				end
			end
			for prop, orig in pairs(lightSaved) do
				local need = (prop == "ClockTime" and tOn) or (FB_PROPS[prop] and fbOn)
				if not need then
					if Lighting[prop] ~= orig then Lighting[prop] = orig end
					lightSaved[prop] = nil
				end
