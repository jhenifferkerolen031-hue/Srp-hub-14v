	o.hl.Parent, o.hl2.Parent = chamsRoot, chamsRoot
	o.cadorn, o.cn = {}, 0
	esp[plr] = o
	if typeof(plr) == "Instance" then
		o.pconns = {
			plr.CharacterAdded:Connect(function(ch) charCache[ch] = nil; o.vis, o.visT = false, 0 end),
			plr.CharacterRemoving:Connect(function(ch) charCache[ch] = nil; pcall(hideDrawable, o) end),
