	for i = 1, 4 do o.dotTk[i] = mk("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), BorderSizePixel = 0, Visible = false}) end
	function o.destroy() for _, i in ipairs(o.all) do i:Destroy() end end
	return o
end

local function hideDrawable(o)
	if not o.shown then return end
	o.shown = false
	o.fill.Visible, o.box.Visible, o.boxOut.Visible = false, false, false
	for i = 1, 8 do o.corners[i].Visible = false end
	o.cornerOn = false
	o.name.Visible, o.info.Visible, o.tool.Visible, o.xtra.Visible = false, false, false, false
	o.hpBg.Visible, o.hpTxt.Visible = false, false
	o.line.Visible, o.look.Visible, o.dot.Visible = false, false, false
	for i = 1, o.nb do o.bones[i].Visible = false; o.bonesO[i].Visible = false end
	o.dotIn.Visible = false
	for i = 1, 4 do o.dotTk[i].Visible = false end
	for i = 1, o.ne do o.edges[i].Visible = false end
	for i = 1, o.nj do o.jd[i].Visible = false end
	o.nb, o.ne, o.nj = 0, 0, 0
end

local function drawEsp(o, d)
	o.shown = true
	local x, y, w, h, col = d.x, d.y, d.w, d.h, d.color
	local cx = x + w / 2

	local fade = d.fade or 1
	local tr = 1 - fade
	o.name.TextTransparency, o.info.TextTransparency, o.tool.TextTransparency = tr, tr, tr
	o.xtra.TextTransparency, o.hpTxt.TextTransparency = tr, tr
	local ts = S.TextSize
	local stx = S.TextOutline and 0.4 or 1
	local fk = S.TextFontSel
	if o.fk ~= fk then
		o.fk = fk
		local ft = fk == "Code" and Enum.Font.Code or (fk == "Arial" and Enum.Font.Arial or (fk == "SciFi" and Enum.Font.SciFi or (fk == "Ubuntu" and Enum.Font.Ubuntu or Enum.Font.GothamBold)))
		o.name.Font, o.info.Font, o.tool.Font, o.xtra.Font, o.hpTxt.Font = ft, ft, ft, ft, ft
	end
	o.name.TextStrokeTransparency, o.info.TextStrokeTransparency, o.tool.TextStrokeTransparency = stx, stx, stx
	o.xtra.TextStrokeTransparency, o.hpTxt.TextStrokeTransparency = stx, stx
	o.info.TextColor3 = P[S.InfoColor]
	o.strokeOut.Transparency = S.OutlineAlpha / 100
	for i = 1, 8 do o.cstrokes[i].Transparency = S.OutlineAlpha / 100 end
	if o.ts ~= ts then
		o.ts = ts
		o.name.TextSize, o.info.TextSize, o.tool.TextSize, o.hpTxt.TextSize, o.xtra.TextSize = ts, ts - 1, ts - 1, ts - 2, ts - 1
	end

	local style, bt = S.BoxStyle, S.BoxThick
	local show2d = S.Box and style ~= "Box3D"
	local isRound = style == "Round"
	local fillOn = show2d and (S.BoxFill or S.BoxGrad)
	o.fill.Visible = fillOn and true or false
	o.fill.BackgroundTransparency = 1 - (S.FillAlpha / 100) * fade
	if o.grad ~= S.BoxGrad then o.grad = S.BoxGrad; o.fillGrad.Enabled = S.BoxGrad end
	if o.roundOn ~= isRound then
		o.roundOn = isRound
		local r = UDim.new(isRound and 0.18 or 0, 0)
		o.cFill.CornerRadius, o.cBox.CornerRadius, o.cOut.CornerRadius = r, r, r
	end
	if o.outOn ~= S.BoxOutline then
		o.outOn = S.BoxOutline
		for i = 1, 8 do o.cstrokes[i].Enabled = S.BoxOutline end
	end
	if fillOn then
		o.fill.Position, o.fill.Size, o.fill.BackgroundColor3 = UDim2.fromOffset(x, y), UDim2.fromOffset(w, h), col
	end
	if show2d and style == "Corner" then
		o.cornerOn = true
		local L = math.max(math.min(w, h) * S.CornerLen / 100, 5)
		local c = o.corners
		place(c[1], x, y, L, bt, col)                 place(c[2], x, y, bt, L, col)
		place(c[3], x + w - L, y, L, bt, col)         place(c[4], x + w - bt, y, bt, L, col)
		place(c[5], x, y + h - bt, L, bt, col)        place(c[6], x, y + h - L, bt, L, col)
		place(c[7], x + w - L, y + h - bt, L, bt, col) place(c[8], x + w - bt, y + h - L, bt, L, col)
		for i = 1, 8 do c[i].BackgroundTransparency = tr end
	elseif o.cornerOn then
		o.cornerOn = false
		for i = 1, 8 do o.corners[i].Visible = false end
	end
	local full = show2d and (style == "Full" or isRound)
	o.box.Visible = full and true or false
	o.boxOut.Visible = (full and S.BoxOutline) and true or false
	if full then
		o.box.Position, o.box.Size = UDim2.fromOffset(x, y), UDim2.fromOffset(w, h)
		o.stroke.Color, o.stroke.Thickness, o.stroke.Transparency = col, bt, tr
		o.boxOut.Position, o.boxOut.Size, o.strokeOut.Thickness = UDim2.fromOffset(x, y), UDim2.fromOffset(w, h), bt + 2
	end
	local n3 = (S.Box and style == "Box3D" and d.c3) and 12 or 0
	for e = 1, n3 do
		local f = o.edges[e]
		if not f then
			f = o.mk("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), BorderSizePixel = 0, Visible = false})
			o.edges[e] = f
		end
		setLine(f, d.c3[EDGES[e][1]], d.c3[EDGES[e][2]], bt, col)
		f.BackgroundTransparency = tr
	end
	for e = n3 + 1, o.ne do o.edges[e].Visible = false end
	o.ne = n3

	o.name.Visible = S.Name
	if S.Name then
		o.name.Text, o.name.TextColor3 = d.name .. ((S.TeamTag and d.tag) and (" [" .. d.tag .. "]") or ""), col
		o.name.Position = UDim2.fromOffset(cx, y - 2)
	end

	local yy = y + h + 2
	o.info.Visible = S.Dist
	if S.Dist then
		o.info.Text = d.dist .. (S.DistUnit == "m" and "m" or " st") .. ((S.Speed and d.spd) and ("  " .. d.spd .. " st/s") or "")
		o.info.Position = UDim2.fromOffset(cx, yy)
		yy += ts + 1
	end
	local hasTool = S.Tool and d.tool ~= nil
	o.tool.Visible = hasTool
	if hasTool then
		o.tool.Text = d.tool
		o.tool.Position = UDim2.fromOffset(cx, yy)
		yy += ts + 1
	end

	local buf = o.xbuf
	table.clear(buf)
	if S.State and d.state then buf[#buf + 1] = d.state end
	if S.VisText and d.vis ~= nil then
		buf[#buf + 1] = d.vis and '<font color="#50ff78">VISÍVEL</font>' or '<font color="#b4b4b4">PAREDE</font>'
	end
	if S.LowHp and d.hp < 0.3 then buf[#buf + 1] = '<font color="#ff5050">VIDA BAIXA</font>' end
	if S.LookAlert and d.alert then buf[#buf + 1] = '<font color="#ffd23c">[!] MIRANDO EM VOCÊ</font>' end
	local hasX = #buf > 0
	o.xtra.Visible = hasX
	if hasX then
		o.xtra.Text = table.concat(buf, "\n")
		o.xtra.Size = UDim2.fromOffset(200, #buf * (ts + 2))
		o.xtra.Position = UDim2.fromOffset(cx, yy)
	end

	o.hpBg.Visible = S.Health
	if S.Health then
		local hw = S.HPWidth
		o.hpBg.Position, o.hpBg.Size = UDim2.fromOffset(S.HPSide == "Right" and (x + w + 3) or (x - 3 - hw), y), UDim2.fromOffset(hw, h)
		o.hp.Size = UDim2.new(1, 0, d.hp, 0)
		o.hp.BackgroundColor3 = hpColor(d.hp)
	end
	o.hpTxt.Visible = S.HealthTxt
	if S.HealthTxt then
		o.hpTxt.Text = S.HealthPct and (math.floor(d.hp * 100 + 0.5) .. "%") or tostring(d.hpn)
		local right = S.HPSide == "Right"
		o.hpTxt.AnchorPoint = Vector2.new(right and 0 or 1, 0.5)
		o.hpTxt.TextXAlignment = right and Enum.TextXAlignment.Left or Enum.TextXAlignment.Right
		o.hpTxt.Position = UDim2.fromOffset(right and (x + w + 8) or (x - 9), y + h * (1 - d.hp))
	end

	if S.Tracer then setLine(o.line, d.tf, d.tt, S.TracerThick, S.TracerSame and col or P[S.TracerColor]); o.line.BackgroundTransparency = tr else o.line.Visible = false end

	local n = S.Skeleton and d.n or 0
	local th = S.SkelThick
	local glow = S.SkelGlow
	local blk = Color3.new(0, 0, 0)
	for i = 1, n do
		local f, g = o.bones[i], o.bonesO[i]
		if not f then
			g = o.mk("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), BorderSizePixel = 0, ZIndex = 1, Visible = false})
			f = o.mk("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), BorderSizePixel = 0, ZIndex = 2, Visible = false})
			circle(g)
			circle(f)
			o.bones[i], o.bonesO[i] = f, g
		end
		local pa, pb = d.pts[i * 2 - 1], d.pts[i * 2]
		if glow then
			setLine(g, pa, pb, th + 5, d.skel)
			g.BackgroundTransparency = math.min(0.78 + tr, 1)
		else
			setLine(g, pa, pb, th + 2, blk)
			g.BackgroundTransparency = math.min(0.5 + tr, 1)
		end
		setLine(f, pa, pb, th, d.skel)
		f.BackgroundTransparency = tr
	end
	for i = n + 1, o.nb do o.bones[i].Visible = false; o.bonesO[i].Visible = false end
	o.nb = n

	local nj = n
	for i = 1, nj do
		local f = o.jd[i]
		if not f then
			f = o.mk("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), BorderSizePixel = 0, ZIndex = 3, Visible = false})
			circle(f)
			o.jd[i] = f
		end
		local pt = d.pts[i * 2]
		local js = th + (S.Joints and 5 or 1.5)
		f.Size = UDim2.fromOffset(js, js)
		f.Position = UDim2.fromOffset(pt.X, pt.Y)
		f.BackgroundColor3 = d.skel
		f.BackgroundTransparency = tr
		f.Visible = true
	end
	for i = nj + 1, o.nj do o.jd[i].Visible = false end
	o.nj = nj

	local hd = S.HeadDot and d.head
	o.dot.Visible = hd and true or false
	o.dotIn.Visible = hd and true or false
	for i = 1, 4 do o.dotTk[i].Visible = hd and true or false end
	if hd then
		local sz = math.max(d.hs * S.HeadDotScale / 100, 8)
		o.dot.Position, o.dot.Size = UDim2.fromOffset(d.head.X, d.head.Y), UDim2.fromOffset(sz, sz)
		o.dotStroke.Color, o.dotStroke.Transparency = col, tr
		local isz = math.max(sz * 0.3, 3)
		o.dotIn.Position, o.dotIn.Size = UDim2.fromOffset(d.head.X, d.head.Y), UDim2.fromOffset(isz, isz)
		o.dotIn.BackgroundColor3, o.dotIn.BackgroundTransparency = col, tr
		local a0 = os.clock() * 1.3
		local r1, r2 = sz / 2 + 2, sz / 2 + 2 + math.max(sz * 0.22, 3)
		for i = 1, 4 do
			local ang = a0 + (i - 1) * math.pi / 2
			local ca, sa = math.cos(ang), math.sin(ang)
			setLine(o.dotTk[i], Vector2.new(d.head.X + ca * r1, d.head.Y + sa * r1), Vector2.new(d.head.X + ca * r2, d.head.Y + sa * r2), 2, col)
			o.dotTk[i].BackgroundTransparency = tr
