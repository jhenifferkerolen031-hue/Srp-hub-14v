local function crossSegs(style, s, g, th)
	local seg, ring, dot = {}, nil, false
	local function add(a, b, c, d) seg[#seg + 1] = {a, b, c, d} end
	if style == "plus" or style == "plusdot" then
		add(-s, 0, -g, 0) add(g, 0, s, 0) add(0, -s, 0, -g) add(0, g, 0, s)
		dot = style == "plusdot"
	elseif style == "tee" then
		add(-s, 0, -g, 0) add(g, 0, s, 0) add(0, g, 0, s)
	elseif style == "x" then
		local a, b = g * 0.7071, s * 0.7071
		add(-b, -b, -a, -a) add(a, a, b, b) add(b, -b, a, -a) add(-a, a, -b, b)
	elseif style == "dot" then
		dot = true
	elseif style == "circle" then
		ring = s
	elseif style == "circledot" then
		ring, dot = s, true
	elseif style == "ringplus" then
		local r = s * 0.55
		ring = r
		add(-s * 1.3, 0, -(r + 2), 0) add(r + 2, 0, s * 1.3, 0) add(0, -s * 1.3, 0, -(r + 2)) add(0, r + 2, 0, s * 1.3)
	elseif style == "square" then
		add(-s, -s, s, -s) add(s, -s, s, s) add(s, s, -s, s) add(-s, s, -s, -s)
	elseif style == "diamond" then
		add(0, -s, s, 0) add(s, 0, 0, s) add(0, s, -s, 0) add(-s, 0, 0, -s)
	elseif style == "triangle" then
		add(0, -s, s * 0.87, s * 0.5) add(s * 0.87, s * 0.5, -s * 0.87, s * 0.5) add(-s * 0.87, s * 0.5, 0, -s)
	elseif style == "chevron" then
		add(-s * 0.7, s * 0.2, 0, -s * 0.5) add(0, -s * 0.5, s * 0.7, s * 0.2)
		add(-s * 0.7, s * 0.8, 0, 0.1 * s) add(0, 0.1 * s, s * 0.7, s * 0.8)
	elseif style == "brackets" then
		local l = s * 0.45
		add(-s, -s, -s + l, -s) add(-s, -s, -s, -s + l) add(s, -s, s - l, -s) add(s, -s, s, -s + l)
		add(-s, s, -s + l, s) add(-s, s, -s, s - l) add(s, s, s - l, s) add(s, s, s, s - l)
	elseif style == "ticks" then
		local a = s * 0.6
		add(-s, 0, -a, 0) add(a, 0, s, 0) add(0, -s, 0, -a) add(0, a, 0, s)
		ring = a * 0.9
	elseif style == "sniper" then
		local L = s * 3
		add(-L, 0, -s, 0) add(s, 0, L, 0) add(0, -L, 0, -s) add(0, s, 0, L)
		ring, dot = s, true
	elseif style == "star" then
		for k = 0, 7 do
			local a = k * math.pi / 4
			add(math.cos(a) * g, math.sin(a) * g, math.cos(a) * s, math.sin(a) * s)
		end
	elseif style == "hex" then
		for k = 0, 5 do
			local a1, a2 = k * math.pi / 3, (k + 1) * math.pi / 3
			add(math.cos(a1) * s, math.sin(a1) * s, math.cos(a2) * s, math.sin(a2) * s)
		end
	elseif style == "dots4" then
		local t = th + 1
		add(-s, 0, -s + t, 0) add(s - t, 0, s, 0) add(0, -s, 0, -s + t) add(0, s - t, 0, s)
	else
		add(-s, 0, -g, 0) add(g, 0, s, 0) add(0, -s, 0, -g) add(0, g, 0, s)
	end
	return seg, ring, dot
end

crossUpdate = function(cx, cy, now, onTarget)
	if not S.Cross then
		for i = 1, 12 do XL[i].Visible, XLo[i].Visible = false, false end
		XRing.Visible, XRingO.Visible, XDot.Visible, XDotO.Visible = false, false, false, false
		return
	end
	local th, s, g = S.CrossThick, S.CrossSize, S.CrossGap
	if S.CrossDyn then
		local ch = LocalPlayer.Character
		local rt = ch and ch:FindFirstChild("HumanoidRootPart")
		if rt then
			local v = rt.AssemblyLinearVelocity
			local k = math.clamp(math.sqrt(v.X * v.X + v.Z * v.Z) / 30, 0, 1)
			g += k * 8
			s += k * 5
		end
	end
	local col
	if S.CrossRainbow then col = Color3.fromHSV((now * 0.4) % 1, 1, 1)
	elseif S.CrossCustom then col = Color3.fromRGB(S.CrossR, S.CrossG, S.CrossB)
	else col = P[S.CrossColor] end
	if S.CrossOnTarget and onTarget then col = TARGET_COLOR end
	local alpha = S.CrossAlpha / 100
	local seg, ring, dot = crossSegs(S.CrossStyle, s, math.max(g, 0), th)
	if S.CrossDot then dot = true end
	local ang = math.rad(S.CrossSpin * now)
	local ca, sa = math.cos(ang), math.sin(ang)
	local function rot(x, y) return Vector2.new(cx + x * ca - y * sa, cy + x * sa + y * ca) end
	for i = 1, 12 do
		local sg = seg[i]
		if sg then
			local a, b = rot(sg[1], sg[2]), rot(sg[3], sg[4])
			if S.CrossOutline then
				setLine(XLo[i], a, b, th + 2, Color3.new(0, 0, 0))
				XLo[i].BackgroundTransparency = math.min(alpha + 0.35, 1)
			else
				XLo[i].Visible = false
			end
			setLine(XL[i], a, b, th, col)
			XL[i].BackgroundTransparency = alpha
		else
			XL[i].Visible, XLo[i].Visible = false, false
		end
	end
	if ring then
		local sz = UDim2.fromOffset(ring * 2, ring * 2)
		local pos = UDim2.fromOffset(cx, cy)
		XRing.Size, XRing.Position, XRing.Visible = sz, pos, true
		XRingS.Color, XRingS.Thickness, XRingS.Transparency = col, th, alpha
		XRingO.Size, XRingO.Position, XRingO.Visible = sz, pos, S.CrossOutline
		XRingOS.Thickness = th + 2
	else
		XRing.Visible, XRingO.Visible = false, false
	end
	if dot then
		local ds = S.CrossDotSize
		XDot.Size, XDot.Position, XDot.BackgroundColor3, XDot.BackgroundTransparency, XDot.Visible = UDim2.fromOffset(ds, ds), UDim2.fromOffset(cx, cy), col, alpha, true
		XDotO.Size, XDotO.Position, XDotO.Visible = UDim2.fromOffset(ds + 2, ds + 2), UDim2.fromOffset(cx, cy), S.CrossOutline
	else
		XDot.Visible, XDotO.Visible = false, false
	end
end
end)()

