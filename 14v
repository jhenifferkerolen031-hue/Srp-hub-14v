local listeners = {}
local function bindRow(p, labelText, key, isMenu)
	local row = pill(p, 42)
	label(row, labelText, UDim2.fromOffset(18, 0), UDim2.new(0.58, -18, 1, 0), nil, 14)
	local b = new("TextButton", {
		Text = "", Size = UDim2.fromOffset(96, 28), Position = UDim2.new(1, -108, 0.5, -14),
		BackgroundColor3 = C.item, BorderSizePixel = 0, AutoButtonColor = false,
	}, row)
	round(b, 8)
	local t = label(b, "", UDim2.new(), UDim2.fromScale(1, 1), Enum.TextXAlignment.Center, 12)
	t.Font = Enum.Font.GothamBold
	local entry = {key = key}
	function entry.paint()
		local cur = listening == entry
		t.Text = cur and "..." or S[key]
		t.TextColor3 = cur and C.accent or (S[key] == "None" and C.dim or C.text)
	end
	entry.paint()
	listeners[#listeners + 1] = entry
	R[#R + 1] = entry.paint
	connect(b.Activated, function()
		if listening == entry then listening = nil; entry.paint(); return end
		local prev = listening
		listening = entry
		if prev then prev.paint() end
		entry.paint()
	end)
	local clr = new("TextButton", {
		Text = "x", Size = UDim2.fromOffset(22, 22), Position = UDim2.new(1, -158, 0.5, -11),
		BackgroundColor3 = C.item, BorderSizePixel = 0, TextColor3 = C.dim, Font = Enum.Font.GothamBold, TextSize = 12,
	}, row)
	round(clr, 6)
	connect(clr.Activated, function()
		S[key] = isMenu and "RightShift" or "None"
		if listening == entry then listening = nil end
		entry.paint()
	end)
end

