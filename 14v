	local ncParams = OverlapParams.new()
	ncParams.FilterType = Enum.RaycastFilterType.Exclude
	ncParams.MaxParts = 200
	local ncSaved, ncT = {}, 0

	local function ncSkip(p)
		if p:IsA("Terrain") then return true end
		local m = p:FindFirstAncestorOfClass("Model")
		return m ~= nil and m:FindFirstChildOfClass("Humanoid") ~= nil
	end

	local function ncRestore(all, keep)
		for p in pairs(ncSaved) do
			if not p.Parent then
				ncSaved[p] = nil
			elseif all or not keep[p] then
				p.CanCollide = true
				ncSaved[p] = nil
			end
		end
	end

	local function noclipStep(now)
		local ch = LocalPlayer.Character
		local hum = ch and ch:FindFirstChildOfClass("Humanoid")
		local root = hum and hum.RootPart
		if not root then return end
		local filter = {ch}
		if G.clone then filter[#filter + 1] = G.clone end
		ncParams.FilterDescendantsInstances = filter

		local dist = S.NoclipDist
		local md = hum.MoveDirection
		local dir
		if md.Magnitude > 0.05 then
			dir = md.Unit
		else
			local lv = root.CFrame.LookVector
			dir = Vector3.new(lv.X, 0, lv.Z)
			if dir.Magnitude < 1e-3 then return end
			dir = dir.Unit
		end

		local pos = root.Position + Vector3.new(0, 1, 0)
		local cf = CFrame.lookAt(pos + dir * (dist / 2), pos + dir * dist)
		local keep = {}
		for _, p in ipairs(Workspace:GetPartBoundsInBox(cf, Vector3.new(6, 4.5, dist + 2), ncParams)) do
			keep[p] = true
			if p.CanCollide and not ncSkip(p) then
				ncSaved[p] = true
				p.CanCollide = false
			end
		end

		if now - ncT > 0.15 then
			ncT = now
			for _, p in ipairs(Workspace:GetPartBoundsInRadius(root.Position, 7, ncParams)) do keep[p] = true end
			ncRestore(false, keep)
		end
	end

