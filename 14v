;(function()
	local function makeMarker(title, col)
		local m = {title = title, col = col, arcs = {}}
		local part = Instance.new("Part")
		part.Name, part.Anchored, part.CanCollide, part.CanTouch, part.CanQuery = "PUM", true, false, false, false
		part.Transparency, part.Size, part.CastShadow = 1, Vector3.new(1, 1, 1), false
		part.Parent = Workspace
		m.part = part
		local function adorn(class, props)
			local a = Instance.new(class)
			for k, v in pairs(props) do a[k] = v end
			a.Adornee, a.AlwaysOnTop, a.ZIndex, a.Color3, a.Visible = part, true, 1, col, false
			a.Parent = chamsRoot
			return a
		end
		m.base = adorn("CylinderHandleAdornment", {Height = 0.06, Radius = 3.2, InnerRadius = 3.0, Transparency = 0.35})
		m.disc = adorn("CylinderHandleAdornment", {Height = 0.05, Radius = 2.2, InnerRadius = 0, Transparency = 0.9})
		for k = 1, 3 do
			m.arcs[k] = adorn("CylinderHandleAdornment", {Height = 0.07, Radius = 3.2, InnerRadius = 2.55, Angle = 70, Transparency = 0.1})
		end
		for k = 4, 5 do
			m.arcs[k] = adorn("CylinderHandleAdornment", {Height = 0.07, Radius = 2.2, InnerRadius = 1.9, Angle = 100, Transparency = 0.2})
		end
		m.beam = adorn("BoxHandleAdornment", {Transparency = 0.3})
		m.beam2 = adorn("BoxHandleAdornment", {Transparency = 0.88})
		m.scan = adorn("CylinderHandleAdornment", {Height = 0.05, Radius = 1.8, InnerRadius = 1.5, Transparency = 0.3})
		m.top = adorn("BoxHandleAdornment", {Size = Vector3.new(0.9, 0.9, 0.9), Transparency = 0.15})
		local bb = Instance.new("BillboardGui")
		bb.Adornee, bb.AlwaysOnTop, bb.LightInfluence, bb.Size, bb.Enabled = part, true, 0, UDim2.fromOffset(180, 44), false
		bb.Parent = chamsRoot
		local t1 = new("TextLabel", {Size = UDim2.new(1, 0, 0, 22), BackgroundTransparency = 1, Font = Enum.Font.GothamBold, TextSize = 16, TextColor3 = col, TextStrokeTransparency = 0.3, Text = title}, bb)
		local t2 = new("TextLabel", {Position = UDim2.fromOffset(0, 22), Size = UDim2.new(1, 0, 0, 18), BackgroundTransparency = 1, Font = Enum.Font.GothamMedium, TextSize = 13, TextColor3 = Color3.new(1, 1, 1), TextStrokeTransparency = 0.4, Text = ""}, bb)
		m.bb, m.t2 = bb, t2
		return m
	end

	local function show(m, on)
		for _, a in ipairs({m.base, m.disc, m.beam, m.beam2, m.scan, m.top}) do a.Visible = on end
		for _, a in ipairs(m.arcs) do a.Visible = on end
		m.bb.Enabled = on
	end

	local function place(m, pos, now, h, sub)
		if m.part.Parent ~= Workspace then m.part.Parent = Workspace end
		m.part.Position = pos
		local flat = CFrame.new(0, 0.05, 0) * CFrame.Angles(math.pi / 2, 0, 0)
		local pulse = 1 + 0.04 * math.sin(now * 3)
		m.base.CFrame, m.base.Radius, m.base.InnerRadius = flat, 3.2 * pulse, 3.0 * pulse
		m.disc.CFrame = flat
		local speeds = {1.6, 1.6, 1.6, -2.4, -2.4}
		local phases = {0, 2.094, 4.188, 0, 3.1416}
		for k, a in ipairs(m.arcs) do a.CFrame = flat * CFrame.Angles(0, 0, speeds[k] * now + phases[k]) end
		m.beam.Size, m.beam.CFrame = Vector3.new(0.12, h, 0.12), CFrame.new(0, h / 2, 0)
		m.beam2.Size, m.beam2.CFrame = Vector3.new(0.6, h, 0.6), CFrame.new(0, h / 2, 0)
		local k = (now * 0.5) % 1
		m.scan.CFrame = CFrame.new(0, k * h, 0) * CFrame.Angles(math.pi / 2, 0, 0)
		m.scan.Transparency = 0.25 + k * 0.75
		m.top.CFrame = CFrame.new(0, h + 1.2, 0) * CFrame.Angles(now * 1.5, now * 2.2, math.rad(45))
		m.bb.StudsOffset = Vector3.new(0, h + 4, 0)
		m.t2.Text = sub
		show(m, true)
	end

	local gm, sm
	connect(RunService.RenderStepped, function()
		local now = os.clock()
		local cam = Workspace.CurrentCamera
		local camPos = cam and cam.CFrame.Position or Vector3.zero
		if S.GhostMark and G.on and G.rroot and G.rroot.Parent then
			if not gm then gm = makeMarker("SEU CORPO", Color3.fromRGB(80, 220, 255)) end
			local p = G.rroot.Position - Vector3.new(0, G.feet or 3, 0)
			place(gm, p, now, math.max(18, S.GhostDepth + 10), string.format("%dm  ·  %d studs abaixo", math.floor((p - camPos).Magnitude), S.GhostDepth))
		elseif gm then
			show(gm, false)
		end
		local cf = miscApi.savedCF
		if S.SaveMark and cf then
			if not sm then sm = makeMarker("POSIÇÃO SALVA", Color3.fromRGB(130, 255, 170)) end
			local p = cf.Position - Vector3.new(0, 3, 0)
			place(sm, p, now, 18, string.format("%dm", math.floor((p - camPos).Magnitude)))
		elseif sm then
			show(sm, false)
		end
	end)

	function markerApi.destroy()
		for _, m in ipairs({gm, sm}) do
			if m then
				pcall(function() m.part:Destroy() end)
				pcall(function() m.bb:Destroy() end)
				for _, a in ipairs({m.base, m.disc, m.beam, m.beam2, m.scan, m.top}) do pcall(function() a:Destroy() end) end
				for _, a in ipairs(m.arcs) do pcall(function() a:Destroy() end) end
			end
		end
		gm, sm = nil, nil
	end
end)()
