local lastHud = ""
connect(RunService.Heartbeat, function()
	local show = S.PcHud and not minimized
	hudBox.Visible = show
	if not show then return end
	local parts = {S.MenuKey}
	for i, f in ipairs(FUNCS) do
		local k, on = S[f[3]], S[f[2]]
		parts[i + 1] = k .. tostring(on)
		hudLines[i].Visible = k ~= "None"
		if k ~= "None" then
			hudLines[i].Text = string.format("[%s] %s: %s", k, f[1], on and "ON" or "OFF")
			hudLines[i].TextColor3 = on and Color3.fromRGB(110, 255, 150) or Color3.fromRGB(170, 170, 170)
		end
	end
	local sig = table.concat(parts, "|")
	if sig ~= lastHud then
		lastHud = sig
		local n = 0
		for _, l in ipairs(hudLines) do if l.Visible then n += 1 end end
		hudBox.Size = UDim2.fromOffset(175, 28 + n * 18)
	end
end)

local function toggleFunc(f)
	local want = not S[f[2]]
	S[f[2]] = want
	if f[5] then
		local ok = f[5](want)
		if ok == false then S[f[2]] = false; want = false end
	end
	refreshAll()
	if S.PcToast then toast(f[1] .. (want and ": ON" or ": OFF")) end
end

onKey = function(code)
	if code == S.MenuKey then toggleMenu(); return end
	for _, f in ipairs(FUNCS) do
		if code == S[f[3]] then toggleFunc(f); return end
	end
end

