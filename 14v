local updateRadar3D
;(function()
	local N = 40
	local rings, blips, en = {}, {}, {}
	local pts, fac = {{}, {}, {}}, {{}, {}, {}}
	local hdr
	local shown = false
	local DANGER = Color3.fromRGB(255, 60, 60)

	local function build()
		for k = 1, 3 do
			rings[k] = {}
			for i = 1, N do
				rings[k][i] = new("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), BorderSizePixel = 0, Visible = false}, espGui)
			end
		end
		hdr = new("TextLabel", {
			AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 54), Size = UDim2.fromOffset(340, 14),
			BackgroundTransparency = 1, Font = Enum.Font.GothamBold, TextSize = 12, TextStrokeTransparency = 0.4, Visible = false,
		}, espGui)
	end

	local function getBlip(n)
		local b = blips[n]
		if not b then
			b = {}
			b.stem = new("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), BorderSizePixel = 0, Visible = false}, espGui)
			b.pulse = new("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1, BorderSizePixel = 0, Visible = false}, espGui)
			circle(b.pulse)
			b.ps = new("UIStroke", {Thickness = 1.5}, b.pulse)
			b.dot = new("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), BorderSizePixel = 0, Visible = false}, espGui)
			circle(b.dot)
			new("UIStroke", {Thickness = 1, Color = Color3.new(0, 0, 0), Transparency = 0.3}, b.dot)
			b.txt = new("TextLabel", {
				AnchorPoint = Vector2.new(0.5, 0), Size = UDim2.fromOffset(140, 12), BackgroundTransparency = 1,
				Font = Enum.Font.GothamBold, TextSize = 10, TextStrokeTransparency = 0.3, Visible = false,
			}, espGui)
			blips[n] = b
		end
		return b
	end

	local function hideBlip(b)
		b.stem.Visible, b.pulse.Visible, b.dot.Visible, b.txt.Visible = false, false, false, false
	end

	local function hideAll3()
		for k = 1, #rings do
			for i = 1, N do rings[k][i].Visible = false end
		end
		for i = 1, #blips do hideBlip(blips[i]) end
		if hdr then hdr.Visible = false end
	end

	updateRadar3D = function(now)
		if not S.Radar3D then
			if shown then shown = false; hideAll3() end
			return
		end
		if not hdr then build() end
		shown = true

		local mroot
		local gc = G.clone
		if gc and gc.Parent then mroot = gc:FindFirstChild("HumanoidRootPart") end
		if not mroot then
			local ch = LocalPlayer.Character
			mroot = ch and (ch:FindFirstChild("HumanoidRootPart") or ch.PrimaryPart)
		end
		if not mroot then hideAll3() return end

		local center = mroot.Position
		local camVec = Camera.CFrame.Position - center
		local R = S.R3Radius

		local n, nearest = 0, math.huge
		for _, plr in ipairs(entityList(false)) do
			if plr ~= LocalPlayer and not (S.HideTeam and sameTeam(plr)) then
				local ch, _, root = getChar(plr)
				if ch and root then
					local off = root.Position - center
					local d = off.Magnitude
					if d <= S.R3Range and d > 0.01 then
						n += 1
						local e = en[n]
						if not e then e = {}; en[n] = e end
						e.unit, e.d = off / d, d
						e.name = S.NameMode == "User" and plr.Name or plr.DisplayName
						if d < nearest then nearest = d end
					end
				end
			end
		end

		local danger = nearest < S.R3Warn and (1 - nearest / S.R3Warn) or 0
		local pulse = 0.5 + 0.5 * math.sin(now * (4 + danger * 8))
		local base = P[S.R3Color] or P[4]
		local ringCol = base:Lerp(DANGER, danger)

		local spin = now * 0.6
		local cs, sn = math.cos(spin), math.sin(spin)
		for k = 1, 3 do
			local pk, fk = pts[k], fac[k]
			for i = 0, N do
				local t = i / N * math.pi * 2
				local c, s = math.cos(t), math.sin(t)
				local dir
				if k == 1 then dir = Vector3.new(c, 0, s)
				elseif k == 2 then dir = Vector3.new(c * cs, s, c * sn)
				else dir = Vector3.new(-c * sn, s, c * cs) end
				local sp = Camera:WorldToViewportPoint(center + dir * R)
				pk[i] = sp.Z > 0 and Vector2.new(sp.X, sp.Y) or false
				fk[i] = dir:Dot(camVec) >= 0
			end
			local seg = rings[k]
			for i = 1, N do
				local f = seg[i]
				local a, b = pk[i - 1], pk[i]
				if a and b then
					local front = fk[i - 1] and fk[i]
					setLine(f, a, b, front and 2 or 1, ringCol)
					f.BackgroundTransparency = front and (0.2 + 0.25 * pulse * danger) or 0.8
				else
					f.Visible = false
				end
			end
		end

		local csp = Camera:WorldToViewportPoint(center)
		local cpos = csp.Z > 0 and Vector2.new(csp.X, csp.Y) or nil
		for i = 1, n do
			local e = en[i]
			local b = getBlip(i)
			local sp = Camera:WorldToViewportPoint(center + e.unit * R)
			if sp.Z > 0 then
				local p2 = Vector2.new(sp.X, sp.Y)
				local t = math.clamp(e.d / S.R3Range, 0, 1)
				local near = e.d < S.R3Warn
				local col = near and DANGER or Color3.fromHSV(t * 0.33, 0.9, 1)
				local size = 16 - t * 9
				local back = e.unit:Dot(camVec) < 0
				local tr = back and 0.45 or 0

				if S.R3Lines and cpos then
					setLine(b.stem, cpos, p2, 1, col)
					b.stem.BackgroundTransparency = back and 0.85 or 0.65
				else
					b.stem.Visible = false
				end

				if near then
					local ph = (now * 1.8 + i * 0.3) % 1
					local ps = size + 6 + 18 * ph
					b.pulse.Size = UDim2.fromOffset(ps, ps)
					b.pulse.Position = UDim2.fromOffset(p2.X, p2.Y)
					b.ps.Color, b.ps.Transparency = col, ph
					b.pulse.Visible = true
				else
					b.pulse.Visible = false
				end

				b.dot.Size = UDim2.fromOffset(size, size)
				b.dot.Position = UDim2.fromOffset(p2.X, p2.Y)
				b.dot.BackgroundColor3 = col
				b.dot.BackgroundTransparency = tr
				b.dot.Visible = true

				if S.R3Labels then
					b.txt.Text = e.name .. "  " .. math.floor(e.d) .. "m"
					b.txt.TextColor3 = col
					b.txt.TextTransparency = tr
					b.txt.Position = UDim2.fromOffset(p2.X, p2.Y + size / 2 + 2)
					b.txt.Visible = true
				else
					b.txt.Visible = false
				end
			else
				hideBlip(b)
			end
		end
		for i = n + 1, #blips do hideBlip(blips[i]) end

		hdr.Visible = n > 0
		if n > 0 then
			hdr.Text = string.format("RADAR 3D  ·  %d por perto  ·  mais perto: %dm", n, math.floor(nearest))
			hdr.TextColor3 = ringCol
		end
	end
end)()

local function resyncEsp()
	local present = {}
	for _, p in ipairs(Players:GetPlayers()) do
		present[p] = true
		if p ~= LocalPlayer and not esp[p] then makeEsp(p) end
	end
	local stale = {}
	for plr in pairs(esp) do
		if typeof(plr) == "Instance" and not present[plr] then stale[#stale + 1] = plr end
	end
	for _, plr in ipairs(stale) do removeEsp(plr) end
	table.clear(stale)
	for plr in pairs(rdots) do
		if not esp[plr] then stale[#stale + 1] = plr end
	end
	for _, plr in ipairs(stale) do
		local dt = rdots[plr]
		if dt then dt:Destroy() end
		rdots[plr] = nil
	end
end

