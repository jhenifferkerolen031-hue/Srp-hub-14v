-- CONFIGURAÇÕES (salvar / carregar / resetar / destruir)
local cfgPanel = panel(pgPc, 0.5, 1, 0, 1, "Configuração", true)
local CFG_FILE = "pvp_universal_v14_config.json"
local function saveCfg()
	if not writefile then toast("executor não suporta salvar arquivo") return end
	local ok, err = pcall(function() writefile(CFG_FILE, HttpService:JSONEncode(S)) end)
	toast(ok and "config salva" or ("erro ao salvar: " .. tostring(err)))
end
local function loadCfg()
	if not (isfile and readfile and isfile(CFG_FILE)) then toast("nenhuma config salva") return end
	local ok, data = pcall(function() return HttpService:JSONDecode(readfile(CFG_FILE)) end)
	if not ok or type(data) ~= "table" then toast("arquivo inválido") return end
	for k, def in pairs(DEFAULTS) do
		if type(data[k]) == type(def) then S[k] = data[k] end
	end
	if setFly then setFly(S.Fly) end
	if setNoclip then setNoclip(S.Noclip) end
	if setFullbright then setFullbright(S.Fullbright) end
	if setAntiRag then setAntiRag(S.AntiRagdoll) end
	if setGhost then setGhost(S.Ghost) end
	if previewApi then safe("preview-model", previewApi.setModel, S.PreviewModel) end
	refreshAll()
	toast("config carregada")
end
local function resetCfg()
	for k, v in pairs(DEFAULTS) do S[k] = v end
	if moveCleanup then moveCleanup() end
	if setGhost then setGhost(false) end
	if previewApi then safe("preview-model", previewApi.setModel, S.PreviewModel) end
	refreshAll()
	toast("padrão restaurado")
end
button(cfgPanel, "Salvar config", saveCfg)
button(cfgPanel, "Carregar config", loadCfg)
button(cfgPanel, "Resetar tudo", resetCfg)
