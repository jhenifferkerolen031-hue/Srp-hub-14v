RunService:BindToRenderStep("PvpUniversalStep", Enum.RenderPriority.Camera.Value + 1, function(dt)
	Camera = Workspace.CurrentCamera
	if not Camera then return end
	if miscCam then safe("misccam", miscCam) end
	local now = os.clock()
	local vp = Camera.ViewportSize
	local cx, cy = vp.X / 2, vp.Y / 2

	safe("aim", function()
	local active = S.Aim and (S.Mode == "auto" or (S.Mode == "btn" and (lock or rmb)) or (S.Mode == "rmb" and rmb))
	tgtPos, tgtPlr, tgtHum, tgtDist = nil, nil, nil, nil
	if active then
		tgtPos, tgtPlr, tgtHum, tgtDist = getTarget()
		if tgtPos then
			local doAim = true
			if S.Deadzone > 0 then
				local sp = Camera:WorldToViewportPoint(tgtPos)
				if (Vector2.new(sp.X, sp.Y) - Vector2.new(cx, cy)).Magnitude < S.Deadzone then doAim = false end
			end
			if doAim then aimAt(tgtPos, dt) end
			lockedPlr = S.Sticky and tgtPlr or nil
		end
	else
		lockedPlr = nil
	end

	local fcol, ccol = P[S.FovColor], P[S.CrossColor]
	fovFrame.Visible = S.Aim and S.ShowFov
	fovFrame.Size = UDim2.fromOffset(S.FovSize * 2, S.FovSize * 2)
	fovFrame.Position = UDim2.fromOffset(cx, cy)
	fovFrame.BackgroundColor3 = fcol
	fovFrame.BackgroundTransparency = S.FovFill and 0.85 or 1
	fovStroke.Color = fcol

	crossUpdate(cx, cy, now, tgtPos ~= nil)

	local showT = false
	if S.Aim and S.ShowTarget and tgtPos then
		local sp = Camera:WorldToViewportPoint(tgtPos)
		if sp.Z > 0 then
			showT = true
			local p2 = Vector2.new(sp.X, sp.Y)
			setLine(aimLine, Vector2.new(cx, cy), p2, 1.5, fcol)
			aimDot.Position, aimDot.BackgroundColor3, aimDot.Visible = UDim2.fromOffset(p2.X, p2.Y), fcol, true
			hud.Visible = true
			hud.Position = UDim2.fromOffset(cx, cy + S.FovSize + 8)
			hud.Text = string.format("%s  |  %d hp  |  %dm", tgtPlr.DisplayName, math.floor(tgtHum + 0.5), math.floor(tgtDist))
		end
	end
	if not showT then aimLine.Visible, aimDot.Visible, hud.Visible = false, false, false end

	local on = lock or rmb
	holdBtn.Visible = S.Aim and S.Mode == "btn" and win.Visible
	holdStroke.Color = on and Color3.fromRGB(90, 255, 140) or Color3.fromRGB(230, 230, 230)
	holdBtn.TextColor3 = on and Color3.fromRGB(90, 255, 140) or Color3.new(1, 1, 1)

	if S.ShowFps then
		if dt > 0 then fps = fps * 0.9 + (1 / dt) * 0.1 end
		fpsLbl.Visible = true
		fpsLbl.Text = string.format("pvp universal v14  ·  %d fps", math.floor(fps + 0.5))
	else
		fpsLbl.Visible = false
	end

	end)

	if now - lastSync > 0.5 then lastSync = now; safe("resync", resyncEsp) end
	safe("esp", updateEsp, now)
	safe("espx", updateEspExtras, now)
	safe("radar", updateRadar)
	safe("radar3d", updateRadar3D, now)
	if previewApi and pages.ESP.Visible and win.Visible and not minimized then safe("preview", previewApi.update, now) end
end)

