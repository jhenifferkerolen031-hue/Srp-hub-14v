local function removeEsp(plr)
	local o = esp[plr]
	if o then
		if o.pconns then
			for _, c in ipairs(o.pconns) do pcall(function() c:Disconnect() end) end
		end
		pcall(o.destroy)
		esp[plr] = nil
	end
	if lockedPlr == plr then lockedPlr = nil end
	local dt = rdots[plr]
	if dt then dt:Destroy() rdots[plr] = nil end
end

local function chamsPartsHide(o)
