	end
	o.mk = mk
	o.fill = mk("Frame", {BackgroundTransparency = 0.85, BorderSizePixel = 0, Visible = false})
	o.cFill = new("UICorner", {CornerRadius = UDim.new(0, 0)}, o.fill)
