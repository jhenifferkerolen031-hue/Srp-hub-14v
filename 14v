	end
end)()

local function sameTeam(plr) return LocalPlayer.Team ~= nil and plr.Team == LocalPlayer.Team end

local CHEST_NAMES = {"UpperTorso", "Torso", "Chest", "Spine2", "Spine1", "Spine", "Body"}
local function bonePos(ch, head, root, bone)
	if bone == "Head" then return head.Position end
	if bone == "Neck" then return head.Position - Vector3.new(0, head.Size.Y * 0.6, 0) end
	if bone == "Chest" then
		for _, n in ipairs(CHEST_NAMES) do
			local p = ch:FindFirstChild(n)
			if p and p:IsA("BasePart") then return p.Position end
		end
		return root.Position
	end
	return root.Position
end
local BONES_AUTO = {"Head", "Neck", "Chest"}
local BONE_LIST = {Head = {"Head"}, Neck = {"Neck"}, Chest = {"Chest"}, Body = {"Body"}, Auto = BONES_AUTO, Any = {"Head", "Chest", "Body"}}
local BONE_NAME = {Head = "Cabeça", Neck = "Pescoço", Chest = "Peito", Body = "Corpo", Auto = "Auto", Any = "Qualquer"}

local function visible(ch, pos)
	local filter = {ch}
	if LocalPlayer.Character then filter[2] = LocalPlayer.Character end
	if G.clone then filter[#filter + 1] = G.clone end
	rayParams.FilterDescendantsInstances = filter
	local o = Camera.CFrame.Position
	return Workspace:Raycast(o, pos - o, rayParams) == nil
end

local function evalPlayer(plr, center, camPos, fovMax)
	if plr == LocalPlayer or (S.Team and sameTeam(plr)) then return end
	if S.IgnoreFriends and isFriend(plr) then return end
	local ch, hum, root, head = getChar(plr)
	if not ch then return end
	if S.IgnoreFF and ch:FindFirstChildOfClass("ForceField") then return end
	local dist = (root.Position - camPos).Magnitude
	if dist > S.AimDist then return end
	local bestPos, bestD
	local function try(pos)
		local sp, on = Camera:WorldToViewportPoint(pos)
		if on then
			local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
			if d <= fovMax and (not bestD or d < bestD) and (not S.Wall or visible(ch, pos)) then bestPos, bestD = pos, d end
		end
	end
	if S.Bone == "Any" then
		local parts = charExtra(ch)
		for i = 1, #parts do try(parts[i].Position) end
		try(head.Position)
	else
		for _, name in ipairs(BONE_LIST[S.Bone] or BONE_LIST.Head) do try(bonePos(ch, head, root, name)) end
	end
	if not bestPos then return end
	if S.AimOffset ~= 0 then bestPos = bestPos + Vector3.new(0, S.AimOffset / 10, 0) end
	if S.Predict > 0 then bestPos = bestPos + root.AssemblyLinearVelocity * (S.Predict / 1000) end
	return bestPos, bestD, dist, (getHp(hum, ch))
end

local function getTarget()
	local vp = Camera.ViewportSize
	local center = Vector2.new(vp.X / 2, vp.Y / 2)
	local camPos = Camera.CFrame.Position

	if S.Sticky and lockedPlr and lockedPlr.Parent then
		local pos, _, dist, hum = evalPlayer(lockedPlr, center, camPos, S.FovSize * 1.8)
		if pos then return pos, lockedPlr, hum, dist end
	end
	lockedPlr = nil

	local bPos, bPlr, bHum, bDist, bScore
	for _, plr in ipairs(entityList(true)) do
		local pos, d, dist, hum = evalPlayer(plr, center, camPos, S.FovSize)
		if pos then
			local score = d
			if S.Priority == "dist" then score = dist elseif S.Priority == "hp" then score = hum end
			if not bScore or score < bScore then bPos, bPlr, bHum, bDist, bScore = pos, plr, hum, dist, score end
		end
	end
	return bPos, bPlr, bHum, bDist
end

local function stretchMat()
	return CFrame.new(0, 0, 0, 1, 0, 0, 0, 1 - S.StretchVal / 100, 0, 0, 0, 1)
end

local function aimAt(pos, dt)
	local cf = Camera.CFrame
	local off = pos - cf.Position
	if off.Magnitude < 1e-3 then return end
	local lv, dv = cf.LookVector, off.Unit
	local cy, cp = math.atan2(-lv.X, -lv.Z), math.asin(math.clamp(lv.Y, -1, 1))
	local ty, tp = math.atan2(-dv.X, -dv.Z), math.asin(math.clamp(dv.Y, -1, 1))
	local dy = (ty - cy + math.pi) % (2 * math.pi) - math.pi
	local k = 1 - math.clamp(S.Smooth / 100, 0, 0.97) ^ (dt * 60)
	local nf = CFrame.new(cf.Position) * CFrame.Angles(0, cy + dy * k, 0) * CFrame.Angles(cp + (tp - cp) * k, 0, 0)
	if S.StretchOn then nf = nf * stretchMat() end
	Camera.CFrame = nf
end

