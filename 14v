							local colr = d.color or Color3.new(1, 1, 1)
							for k, df in ipairs(RING_DEF) do
								local ad = x.rings[k]
								if ad then
									if ad.Adornee ~= root then ad.Adornee = root end
									local rr = R * df[1]
									ad.Radius = rr
									ad.InnerRadius = math.max(rr - df[2], 0)
									ad.CFrame = base * CFrame.Angles(0, 0, df[4] * now + df[5])
									ad.Color3 = colr
									ad.Visible = true
								end
							end
						elseif x.rings then
							for _, ad in ipairs(x.rings) do if ad then ad.Visible = false end end
						end
					elseif x.rings then
						for _, ad in ipairs(x.rings) do if ad then ad.Visible = false end end
					end
				elseif x then
					x.lbl.Visible = false
					if x.ring then x.ring.Visible = false end
					if x.rings then for _, ad in ipairs(x.rings) do if ad then ad.Visible = false end end end
				end
			end
		end

		for plr, x in pairs(xp) do
			if not esp[plr] then
				pcall(function() x.lbl:Destroy() end)
				if x.ring then pcall(function() x.ring:Destroy() end) end
				xp[plr] = nil
			end
		end

		listLbl.Visible = S.XList
		if S.XList and now - listT > 0.25 then listT = now; buildList(camPos) end

		if S.XNear and nearestPlr and nearestDist and nearestDist <= S.XNearDist then
			nearLbl.Visible = true
			nearLbl.Text = string.format("⚠ %s a %dm", nearestPlr.DisplayName, math.floor(nearestDist))
			nearLbl.TextColor3 = (math.floor(now * 3) % 2 == 0) and Color3.fromRGB(255, 70, 70) or Color3.new(1, 1, 1)
		else
			nearLbl.Visible = false
		end

		for i = #notes, 1, -1 do
			if notes[i][2] < now then table.remove(notes, i) end
		end
		if S.XJoin and #notes > 0 then
			local t = {}
			for i = 1, #notes do t[i] = notes[i][1] end
			noteLbl.Text = table.concat(t, "\n")
			noteLbl.Visible = true
		else
			noteLbl.Visible = false
		end
	end
end)()
